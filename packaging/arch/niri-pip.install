post_install() {
  cat <<'MSG'

niri-pip installed.
For each Niri user, run inside the Niri session:
  niripip-integrate
  systemctl --user enable --now niripip.service
  niripip doctor

Open settings with:
  niripip ui

Scratchpad minimize:
  Mod+M          -> niripip minimize
  Mod+Shift+M    -> niripip restore-minimized

Compact power-user controller:
  niripip menu

MSG
}

post_upgrade() {
  post_install
}
