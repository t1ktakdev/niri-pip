post_install() {
  cat <<'MSG'

niri-pip installed.
For each Niri user, run inside the Niri session:
  niripip-integrate
  systemctl --user enable --now niripip.service
  niripip doctor

Open settings with:
  niripip ui

Hide / restore:
  Mod+Alt+M          -> niripip hide
  Mod+Alt+Shift+M    -> niripip restore-hidden

Compact power-user controller:
  niripip menu

MSG
}

post_upgrade() {
  post_install
}
